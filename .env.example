# Copy to .env and fill in real values. Never commit .env.

# Bearer token required on all staff endpoints (Authorization: Bearer <STAFF_TOKEN>).
# The app REFUSES TO START if this is unset or shorter than 16 characters, so the
# placeholder below ("change-me", 9 chars) can never be used by mistake.
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STAFF_TOKEN=change-me

# SQLAlchemy database URL used by the app, Alembic and the seed script (see docs/database.md).
# SQLite file (path relative to backend/) or the Compose PostgreSQL below. postgres:// and
# postgresql:// URLs are accepted and switched to the psycopg 3 driver automatically.
DATABASE_URL=sqlite:///./benchtrack.db
# DATABASE_URL=postgresql+psycopg://benchtrack:benchtrack@127.0.0.1:5433/benchtrack

# PostgreSQL service in docker-compose.yml (local development only — use strong values
# anywhere else). Published on 127.0.0.1:POSTGRES_PORT.
POSTGRES_USER=benchtrack
POSTGRES_PASSWORD=benchtrack
POSTGRES_DB=benchtrack
POSTGRES_PORT=5433

# Docker Compose app service (docker compose up --build -d --wait). Compose sets
# DATABASE_URL (pointing at the db service) and LOG_FORMAT=json itself, overriding the
# values in this file. Keep POSTGRES_PASSWORD URL-safe: it is embedded in DATABASE_URL.
# Host port for the app (change it if 8000 is busy) and the shop name baked into the SPA.
APP_PORT=8000
VITE_SHOP_NAME=BenchTrack Repair

# Integration tests (uv run pytest -m integration) DROP AND RECREATE the schema of this
# database, so its name must end in "_test". It is created automatically if missing.
# TEST_DATABASE_URL=postgresql+psycopg://benchtrack:benchtrack@127.0.0.1:5433/benchtrack_test

# Logging level: DEBUG, INFO, WARNING, ERROR (default INFO)
LOG_LEVEL=INFO

# Log output format: text | json (default text; use json in Compose and production)
LOG_FORMAT=text
