# Copy to .env and fill in real values. Never commit .env.

# Bearer token required on all staff endpoints (Authorization: Bearer <STAFF_TOKEN>).
# The app REFUSES TO START if this is unset or shorter than 16 characters, so the
# placeholder below ("change-me", 9 chars) can never be used by mistake.
# Generate a real value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
STAFF_TOKEN=change-me

# SQLAlchemy database URL. SQLite for local dev/tests; PostgreSQL in Compose/production,
# e.g. postgresql+psycopg://benchtrack:benchtrack@localhost:5432/benchtrack
DATABASE_URL=sqlite:///./benchtrack.db

# Logging level: DEBUG, INFO, WARNING, ERROR (default INFO)
LOG_LEVEL=INFO

# Log output format: text | json (default text; use json in Compose and production)
LOG_FORMAT=text
