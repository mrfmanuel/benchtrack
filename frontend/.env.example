# Frontend build-time settings. VITE_* values are embedded in the public bundle:
# never put secrets (such as STAFF_TOKEN) here.

# Shop name printed on receipts and page headers.
VITE_SHOP_NAME=BenchTrack Repair

# The dev proxy target (/api, /docs) is a shell variable, not read from this file:
# $env:API_PROXY_TARGET = "http://127.0.0.1:8000"   (the default)
