{
  "description": "BenchTrack guardrails: block secrets access, destructive commands and pushes to main; report ruff problems after Python edits.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "python", "${CLAUDE_PLUGIN_ROOT}/hooks/guard.py"],
            "timeout": 20,
            "onFailure": "block",
            "statusMessage": "BenchTrack guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "uv",
            "args": ["run", "--no-project", "--quiet", "python", "${CLAUDE_PLUGIN_ROOT}/hooks/ruff_check.py"],
            "timeout": 90,
            "statusMessage": "ruff check"
          }
        ]
      }
    ]
  }
}
